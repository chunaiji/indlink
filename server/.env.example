# ===== 服务 =====
APP_ENV=dev
APP_PORT=8980
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# ===== MySQL =====
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/driftbottle?charset=utf8mb4&parseTime=true&loc=Local

# ===== Redis =====
# 方式一(推荐):连接串,优先生效
REDIS_URL=redis://:password@127.0.0.1:6379/0
# 方式二:拆分字段(REDIS_URL 为空时回退)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 微信小程序 =====
WX_APPID=
WX_SECRET=
# 微信支付(商户号 / APIv3 密钥 / 商户证书序列号 / 商户私钥路径)
WX_MCH_ID=
WX_PAY_APIV3_KEY=
WX_PAY_SERIAL_NO=
WX_PAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
# 回调验签:微信平台公钥(公钥模式 pub_key.pem)或平台证书(wechatpay_cert.pem)
WX_PAY_PLATFORM_KEY_PATH=./cert/wx_platform_pub.pem
WX_PAY_PLATFORM_SERIAL=
WX_PAY_NOTIFY_URL=https://your-domain/api/pay/callback/wx

# ===== 支付宝小程序 =====
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=https://your-domain/api/pay/callback/alipay

# ===== App 端(Flutter) =====
# App 只有一个包,租户是部署期常量:设了这个值就不必往 app_credentials 加 platform=app 行。
# 留空(0)时退回原逻辑:多租户下没凭证行就报「未配置 App 凭证」。
APP_DEFAULT_TENANT_ID=0

# ===== 本地图片上传(联调临时方案,后续切对象存储) =====
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=

# ===== 对象存储(占位,后续接入) =====
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
