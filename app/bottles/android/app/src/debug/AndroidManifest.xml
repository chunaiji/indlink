<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- 关掉 Impeller，debug 构建改用 Skia 渲染。

             Android 模拟器的 OpenGLES 驱动编译不了 Impeller 的 FramebufferBlend
             着色器（'inout' / 'location' 限定符不被支持），pipeline 链接失败后
             需要混合的绘制全部画不出来 —— 表现为**整屏全黑**，App 看着像卡死。

             只放在 debug 变体里：真机上 Impeller 是正常的，而且比 Skia 快，
             release 不该跟着降级。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
